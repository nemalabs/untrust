#!/usr/bin/env bash
set -euo pipefail
umask 077

CONFIG="${CLAUDE_CONFIG:-$HOME/.claude.json}"
BACKUP_DIR="${UNTRUST_BACKUP_DIR:-$HOME/.claude/untrust-backups}"
BACKUP_KEEP="${UNTRUST_BACKUP_KEEP:-10}"

usage() {
  cat <<'EOF'
untrust - drop a project entry from Claude Code's ~/.claude.json

Usage:
  untrust [-n] [-c FILE] [PATH]

Arguments:
  PATH               target project path (default: current directory)

Options:
  -n, --dry-run      report the matched entry without modifying anything
  -c, --config FILE  config path (overrides CLAUDE_CONFIG)
  -h, --help         show this help

PATH is made absolute and "." / ".." are resolved lexically, then the key is
matched against .projects by exact string. A timestamped backup of the whole
config is written before the entry is removed. If the config is a symlink,
the file it points to is rewritten.

Environment:
  CLAUDE_CONFIG        config path       (default: ~/.claude.json)
  UNTRUST_BACKUP_DIR   backup directory  (default: ~/.claude/untrust-backups)
  UNTRUST_BACKUP_KEEP  backups to keep   (default: 10, 0 disables pruning)
EOF
}

die() {
  printf 'untrust: %s\n' "$1" >&2
  exit 1
}

abspath() {
  local rest="$1" part out=""
  case "$rest" in
    /*) ;;
    *) rest="$PWD/$rest" ;;
  esac
  while [ -n "$rest" ]; do
    part="${rest%%/*}"
    if [ "$part" = "$rest" ]; then rest=""; else rest="${rest#*/}"; fi
    case "$part" in
      '' | .) ;;
      ..) out="${out%/*}" ;;
      *) out="$out/$part" ;;
    esac
  done
  printf '%s' "${out:-/}"
}

has_key() {
  jq -e --arg k "$1" '(.projects // {}) | has($k)' "$CONFIG" >/dev/null 2>&1
}

dry_run=0
target=""
config_opt=""
while [ $# -gt 0 ]; do
  case "$1" in
    -n | --dry-run) dry_run=1 ;;
    -c | --config)
      if [ $# -lt 2 ] || [ -z "$2" ]; then die "option requires a non-empty argument: $1"; fi
      config_opt="$2"
      shift
      ;;
    --config=*)
      config_opt="${1#--config=}"
      [ -n "$config_opt" ] || die "option requires a non-empty argument: --config"
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -*) die "unknown option: $1" ;;
    *)
      if [ -n "$target" ]; then die "too many arguments"; fi
      target="$1"
      ;;
  esac
  shift
done
if [ $# -gt 0 ]; then
  if [ -n "$target" ] || [ $# -gt 1 ]; then die "too many arguments"; fi
  target="$1"
fi
if [ -n "$config_opt" ]; then CONFIG="$config_opt"; fi

case "$BACKUP_KEEP" in
  '' | *[!0-9]*) die "UNTRUST_BACKUP_KEEP must be a non-negative integer: $BACKUP_KEEP" ;;
esac

command -v jq >/dev/null 2>&1 || die "jq is required but not installed"
case "$CONFIG" in
  /*) ;;
  *) CONFIG="$PWD/$CONFIG" ;;
esac
[ -f "$CONFIG" ] || die "config not found: $CONFIG"
real_config="$(realpath "$CONFIG")" || die "cannot resolve config path: $CONFIG"
CONFIG="$real_config"
jq -e . "$CONFIG" >/dev/null 2>&1 || die "config is not valid JSON: $CONFIG"

key="$(abspath "${target:-$PWD}")"
if ! has_key "$key"; then
  # A shell can sit in a symlinked cwd while the config holds the resolved path.
  phys="$( (cd "$key" 2>/dev/null && pwd -P) || true)"
  if [ -n "$phys" ] && [ "$phys" != "$key" ] && has_key "$phys"; then
    key="$phys"
  else
    die "no project entry matches: $key"
  fi
fi

if [ "$dry_run" -eq 1 ]; then
  printf 'untrust: would remove %s\n' "$key"
  exit 0
fi

mkdir -p "$BACKUP_DIR"
backup="$BACKUP_DIR/claude.json.$(date +%Y%m%d-%H%M%S).$$"
cp -p "$CONFIG" "$backup"

tmp="$CONFIG.untrust.$$"
trap 'rm -f "$tmp"' EXIT
# Claude Code rewrites this file while sessions run. Rewriting from the backup
# and comparing right before the replace keeps a concurrent write from being
# silently overwritten.
jq --arg k "$key" 'del(.projects[$k])' "$backup" >"$tmp"
jq -e --arg k "$key" '(.projects // {}) | has($k) | not' "$tmp" >/dev/null ||
  die "entry survived the rewrite, config left untouched: $key"
mode="$(stat -c '%a' "$CONFIG" 2>/dev/null)" || mode="$(stat -f '%OLp' "$CONFIG")" || mode=600
case "$mode" in
  [0-7][0-7][0-7] | [0-7][0-7][0-7][0-7]) ;;
  *) die "unexpected config mode, config left untouched: $mode" ;;
esac
chmod "$mode" "$tmp"
cmp -s "$backup" "$CONFIG" ||
  die "config changed during the rewrite, left untouched (close running Claude Code sessions and retry): $CONFIG"
mv -f "$tmp" "$CONFIG"
trap - EXIT

if [ "$BACKUP_KEEP" -gt 0 ]; then
  # Sort by the timestamp in the name, not by mtime: cp -p stamps each backup
  # with the config's own mtime, so mtime order is not creation order.
  (ls -1 "$BACKUP_DIR"/claude.json.* 2>/dev/null || true) |
    sort -r |
    tail -n "+$((BACKUP_KEEP + 1))" |
    while IFS= read -r old; do rm -f "$old"; done
fi

printf 'untrust: removed %s\n' "$key"
printf 'untrust: backup at %s\n' "$backup"
printf 'untrust: a running Claude Code session may write the entry back on exit\n' >&2
